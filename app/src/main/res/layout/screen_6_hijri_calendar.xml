<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 6: হিজরি ক্যালেন্ডার ও সমন্বয় (Hijri Calendar & Moon Sighting Adjustment) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#061711">

    <!-- Top Green Header Container with Islamic Arc Shape -->
    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="#0F644A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp">

            <!-- Stepper (ধাপ ৬ / ৬ - 100% Complete) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvStepIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ধাপ ৬ / ৬"
                    android:textColor="#E5A823"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbStepProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginStart="12dp"
                    android:progress="100"
                    android:progressTint="#E5A823" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="হিজরি ক্যালেন্ডার"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="চাঁদ দেখার ওপর ভিত্তি করে হিজরি তারিখ নির্ধারণ করুন"
                android:textColor="#B2E0D0"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- 1. Prominent Today's Hijri Date Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardHijriDatePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#0D3B2E"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">

                    <!-- Top row: Crescent icon & Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#E5A823"
                            android:contentDescription="Moon Icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="আজকের হিজরি তারিখ"
                            android:textColor="#2DD4BF"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvMoonPhase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#164D3B"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="শুক্লপক্ষ"
                            android:textColor="#E5A823"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- Large Hijri Date -->
                    <TextView
                        android:id="@+id/tvHijriDateDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="১১ রবিউস সানি, ১৪৪৬ হিজরি"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="22sp" />

                    <!-- Gregorian Equivalent Date -->
                    <TextView
                        android:id="@+id/tvGregorianDateDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="বুধবার, ১৪ অক্টোবর ২০২৬"
                        android:textColor="#E5A823"
                        android:textSize="13sp" />

                    <!-- Islamic Occasion Tag if any -->
                    <TextView
                        android:id="@+id/tvOccasionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#14543F"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="পবিত্র ফাতেহা-ই-ইয়াজদাহম মোবারক"
                        android:textColor="#6EE7B7"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Manual Moon Sighting Adjustment Stepper Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardHijriAdjustment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="#0A281F"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="হিজরি তারিখ সংশোধন (চাঁদ দেখা অনুসারে)"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="আপনার এলাকায় স্থানীয় চাঁদ দেখার উপর ভিত্তি করে ১ বা ২ দিন সমন্বয় করুন।"
                        android:textColor="#94B8A9"
                        android:textSize="12sp" />

                    <!-- Stepper Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="16dp">

                        <!-- Decrement Button (-) -->
                        <Button
                            android:id="@+id/btnDecrementOffset"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="-"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#13503D" />

                        <!-- Current Offset Display -->
                        <TextView
                            android:id="@+id/tvCurrentOffsetDisplay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="+১ দিন (একদিন যোগ)"
                            android:textColor="#E5A823"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <!-- Increment Button (+) -->
                        <Button
                            android:id="@+id/btnIncrementOffset"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#13503D" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Upcoming Islamic Special Events & Days -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardIslamicEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="#0A281F"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="আসন্ন গুরুত্বপূর্ণ ইসলামী দিবসসমূহ"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <!-- Event Item 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="পবিত্র ফাতেহা-ই-ইয়াজদাহম"
                            android:textColor="#E0F2E9"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="১১ রবিউস সানি"
                            android:textColor="#E5A823"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Event Item 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="পবিত্র মিলাদুন্নবী (ﷺ)"
                            android:textColor="#E0F2E9"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="১২ রবিউল আউয়াল"
                            android:textColor="#E5A823"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Event Item 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="পবিত্র শবে বরাত"
                            android:textColor="#E0F2E9"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="১৫ শাবান"
                            android:textColor="#E5A823"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Button Container: Finish Onboarding & Enter Home Screen -->
    <FrameLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#061711"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnFinishOnboarding"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="হোম স্ক্রিনে প্রবেশ করুন ➔"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#0F644A" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
