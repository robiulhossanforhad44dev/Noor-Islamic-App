<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 8: অ্যাপ সেটিংস ও কনফিগারেশন (App Settings & Configuration) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#04130E">

    <!-- Top App Bar (অ্যাপ সেটিংস) -->
    <FrameLayout
        android:id="@+id/settingsTopAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#0F644A"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnSettingsBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="অ্যাপ সেটিংস"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="21sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/settingsTopAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- Top Header Card (সেটিংস ও কনফিগারেশন) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F644A"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="#13503D"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="#E5A823"
                        android:contentDescription="Settings Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সেটিংস ও কনফিগারেশন"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="লোকেশন, আজান, থিম, ডাটাবেস ও একাউন্ট নিয়ন্ত্রণ"
                            android:textColor="#B2E0D0"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- =============================================================== -->
            <!-- PART 1: ব্যবহারকারী একাউন্ট (User Account) -->
            <!-- =============================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="16dp"
                    android:background="#2DD4BF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ব্যবহারকারী একাউন্ট"
                    android:textColor="#34D399"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#072118"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="#0C382A"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#2DD4BF"
                        android:contentDescription="User Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google দিয়ে সাইন ইন করুন"
                            android:textColor="#38B2AC"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="আপনার একাউন্ট সিঙ্ক করতে ও সুবিধা পেতে"
                            android:textColor="#94B8A9"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#4A7363"
                        android:contentDescription="Arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- =============================================================== -->
            <!-- PART 2: ডাটা ও অফলাইন স্টোরেজ (Data & Offline Storage) -->
            <!-- =============================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="16dp"
                    android:background="#2DD4BF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ডাটা ও অফলাইন স্টোরেজ"
                    android:textColor="#34D399"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#072118"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="#0C382A"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_save"
                        app:tint="#2DD4BF"
                        android:contentDescription="Database Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ডাটাবেস ও ফাইল ম্যানেজার"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="কুরআন, হাদিস ও ইসলামিক বইয়ের ডাটাবেস ফাইল ডাউনলোড বা রিমুভ করুন"
                            android:textColor="#94B8A9"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#4A7363"
                        android:contentDescription="Arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- =============================================================== -->
            <!-- PART 3: ভাষা নির্বাচন (Language) & ফন্ট সেটিংস -->
            <!-- =============================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="16dp"
                    android:background="#2DD4BF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ভাষা নির্বাচন (Language)"
                    android:textColor="#34D399"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#072118"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Language Pills Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="#104434"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇧🇩 বাংলা"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="#0A291F"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇬🇧 English"
                                android:textColor="#94B8A9"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="#0A291F"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🇵🇰 اردو"
                                android:textColor="#94B8A9"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Active Language Indicator Strip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#0A291F"
                        android:padding="10dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="#2DD4BF"
                            android:contentDescription="Globe Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="সক্রিয় ভাষা: বাংলা (সকল মেনু ও ইসলামিক কন্টেন্ট)"
                            android:textColor="#C0E0D4"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ফন্ট সেটিংস (Font Settings) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#072118"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="#0C382A"
                        android:gravity="center"
                        android:text="Tt"
                        android:textColor="#2DD4BF"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ফন্ট সেটিংস"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="বাংলা, আরবি, উর্দু ও ইংরেজি ফন্ট এবং টেক্সট সাইজ কাস্টমাইজ করুন"
                            android:textColor="#94B8A9"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#4A7363"
                        android:contentDescription="Arrow" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- =============================================================== -->
            <!-- PART 4: অ্যাপ থিম ও কালার স্কিম (App Theme & Color Scheme) -->
            <!-- =============================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3.5dp"
                    android:layout_height="16dp"
                    android:background="#2DD4BF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="অ্যাপ থিম ও কালার স্কিম"
                    android:textColor="#34D399"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#072118"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ইসলামিক কালার প্যালেট"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="আপনার পছন্দের আধ্যাত্মিক রঙের আবহ নির্বাচন করুন"
                        android:textColor="#94B8A9"
                        android:textSize="12sp" />

                    <!-- 7 Palette Rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="#0E382A"
                        android:padding="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🟢🟡 জমুররুদ সবুজ • ঐতিহ্য ও প্রশান্তি"
                            android:textColor="#E5A823"
                            android:textStyle="bold"
                            android:textSize="12.5sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/checkbox_on_background"
                            app:tint="#2DD4BF"
                            android:contentDescription="Checked" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#09251C"
                        android:padding="10dp"
                        android:text="🔴🟡 শাহানা মেরুন • গাম্ভীর্য ও মহিমা"
                        android:textColor="#E0F2E9"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#09251C"
                        android:padding="10dp"
                        android:text="🫒⚪ নুরানী জলপাই • ইলম ও सुकून"
                        android:textColor="#E0F2E9"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#09251C"
                        android:padding="10dp"
                        android:text="🔵🟣 নীলকান্তমণি • নূর ও গোলাবি আভা"
                        android:textColor="#E0F2E9"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#09251C"
                        android:padding="10dp"
                        android:text="🌲⚪ শাহানা সাইপ্রেস • ধৈর্য ও গভীর প্রশান্তি"
                        android:textColor="#E0F2E9"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#09251C"
                        android:padding="10dp"
                        android:text="🟠🟡 রমাদান আম্বার • উষ্ণতা ও মাগফিরাত"
                        android:textColor="#E0F2E9"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#09251C"
                        android:padding="10dp"
                        android:text="🌊⚪ সাগর ফিরোজা • বিশুদ্ধতা ও আকাশী সতেজতা"
                        android:textColor="#E0F2E9"
                        android:textSize="12.5sp" />

                    <!-- Display Mode Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="ডিসপ্লে মোড"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="#13503D"
                            android:padding="10dp"
                            android:gravity="center"
                            android:text="⭐ সিস্টেম"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="#0A291F"
                            android:padding="10dp"
                            android:gravity="center"
                            android:text="☀️ লাইট"
                            android:textColor="#86A89B"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="#0A291F"
                            android:padding="10dp"
                            android:gravity="center"
                            android:text="🌙 নাইট"
